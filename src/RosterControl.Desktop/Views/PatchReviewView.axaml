<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RosterControl.Desktop.ViewModels"
             xmlns:c="using:RosterControl.Desktop.Controls"
             x:Class="RosterControl.Desktop.Views.PatchReviewView"
             x:DataType="vm:PatchReviewViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="2,2,0,12">
      <StackPanel Spacing="3">
        <TextBlock Text="PATCH REVIEW" Classes="heading" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Builds saved on an older patch whose items changed or were removed, or whose runes no longer exist. Open a build to update it (any edit marks it reviewed), or mark it reviewed as it is." />
      </StackPanel>
      <Button Grid.Column="1" Classes="small" VerticalAlignment="Center" Margin="12,0,0,0" Command="{Binding MarkAllReviewedCommand}" IsVisible="{Binding State.HasEntries}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:LucideIcon Kind="check-check" Width="13" Height="13" />
          <TextBlock Text="Mark all reviewed" FontSize="12" />
        </StackPanel>
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" IsVisible="{Binding State.HasEntries}">
      <ItemsControl ItemsSource="{Binding State.Entries}" MaxWidth="980" HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReviewEntry">
            <Border Classes="card" Padding="14,12" MinWidth="760">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:AssetImage Source="{Binding PortraitUrl}" Width="44" Height="44" CornerRadius="7" Zoom="1.08" Ring="{DynamicResource Brush.GoldDark}" RingThickness="1" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="6">
                  <StackPanel Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding ChampionName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.GoldLight}" />
                      <TextBlock Text="·" Classes="secondary" />
                      <TextBlock Text="{Binding BuildName}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding SavedOnText}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReviewChangeLine">
                        <Grid ColumnDefinitions="Auto,*">
                          <Panel Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Top">
                            <Border Classes="itemframe" IsVisible="{Binding HasItemIcon}">
                              <c:AssetImage Source="{Binding ItemIconUrl}" Width="20" Height="20" CornerRadius="2" FallbackText="?" />
                            </Border>
                            <c:LucideIcon Kind="{Binding Icon}" Width="14" Height="14" IsVisible="{Binding !HasItemIcon}"
                                          Foreground="{DynamicResource Brush.Bad}" />
                          </Panel>
                          <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Brush.Warning}" Classes.removal="{Binding IsRemoval}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top">
                  <Button Classes="primary small" Command="{Binding $parent[UserControl].((vm:PatchReviewViewModel)DataContext).OpenBuildCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:LucideIcon Kind="external-link" Width="13" Height="13" Foreground="{DynamicResource Brush.GoldLight}" />
                      <TextBlock Text="Open build" FontSize="12" Foreground="{DynamicResource Brush.GoldLight}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost small" Command="{Binding $parent[UserControl].((vm:PatchReviewViewModel)DataContext).MarkReviewedCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:LucideIcon Kind="check" Width="13" Height="13" />
                      <TextBlock Text="Mark reviewed" FontSize="12" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Nothing to review -->
    <Border Grid.Row="1" Classes="card" VerticalAlignment="Top" Padding="24,28" MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding !State.HasEntries}">
      <StackPanel Spacing="10" HorizontalAlignment="Center">
        <c:LucideIcon Kind="circle-check" Width="34" Height="34" Foreground="{DynamicResource Brush.Good}" HorizontalAlignment="Center" IsVisible="{Binding !IsScanning}" />
        <TextBlock Text="{Binding EmptyText}" Classes="title" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding !IsScanning}" />
        <TextBlock Text="Checking your builds against this patch…" Classes="secondary" HorizontalAlignment="Center" IsVisible="{Binding IsScanning}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
