<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RosterControl.Desktop.ViewModels"
             xmlns:c="using:RosterControl.Desktop.Controls"
             x:Class="RosterControl.Desktop.Views.RunesView"
             x:DataType="vm:RunesViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="2,2,0,12">
      <StackPanel Spacing="3">
        <TextBlock Text="RUNES" Classes="heading" />
        <TextBlock Text="Every rune and stat shard with its formulas from the game files and the builds of yours that use it. Click one for details." Classes="caption" />
      </StackPanel>
      <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
        <TextBlock Text="{Binding CountText}" FontSize="11" Classes="secondary num" />
      </Border>
    </Grid>

    <Border Grid.Row="1" Classes="card" Padding="12,10" Margin="0,0,0,12">
      <WrapPanel ItemSpacing="10" LineSpacing="8">
        <TextBox Classes="search" Width="260" PlaceholderText="Search runes… (Enter selects)" Text="{Binding Search}" c:InputHelpers.EnterCommand="{Binding SelectFirstCommand}" Name="RuneSearch" />
        <ComboBox ItemsSource="{Binding PathOptions}" SelectedItem="{Binding SelectedPath}" MinWidth="150" VerticalAlignment="Center" ToolTip.Tip="Rune path" Name="RunePath" />
        <ComboBox ItemsSource="{Binding SlotOptions}" SelectedItem="{Binding SelectedSlot}" MinWidth="130" VerticalAlignment="Center" ToolTip.Tip="Slot" />
        <ToggleButton Classes="chip" IsChecked="{Binding OnlyInBuilds}" VerticalAlignment="Center" Height="30" ToolTip.Tip="Only runes used in at least one of your builds">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:LucideIcon Kind="book-marked" Width="13" Height="13" Foreground="{Binding $parent[ToggleButton].Foreground}" />
            <TextBlock Text="In my builds" FontSize="12" Foreground="{Binding $parent[ToggleButton].Foreground}" />
          </StackPanel>
        </ToggleButton>
        <Button Classes="ghost small" Content="Clear filters" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}" VerticalAlignment="Center" />
      </WrapPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,12,400">
      <ScrollViewer>
        <Panel>
          <ItemsControl ItemsSource="{Binding Sections}" Name="RuneSections">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" Margin="0,0,8,8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RuneSection">
                <Border Classes="card" Padding="14,12" Width="452" VerticalAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                      <Border Width="3" CornerRadius="1.5" Background="{Binding Accent}" Margin="0,2,10,2" />
                      <c:AssetImage Grid.Column="1" Source="{Binding IconUrl}" Width="28" Height="28" ShowPlaceholder="False" IsVisible="{Binding HasIcon}" Margin="0,0,10,0" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Classes="title" />
                        <TextBlock Text="{Binding Tagline}" Classes="caption" />
                      </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuneRowGroup">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Label}" Classes="overline muted" FontSize="9.5" Margin="4,0,0,0" />
                            <ItemsControl ItemsSource="{Binding Tiles}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuneTileViewModel">
                                  <Border Classes="tile" Classes.selectedbuild="{Binding IsSelected}" Width="98" Padding="4,6" Margin="2" ToolTip.Tip="{Binding Tip}" BorderThickness="1" BorderBrush="Transparent"
                                          c:Dnd.ClickCommand="{Binding $parent[UserControl].((vm:RunesViewModel)DataContext).SelectCommand}">
                                    <StackPanel Spacing="4">
                                      <Panel Width="54" Height="54">
                                        <c:AssetImage Source="{Binding IconUrl}" Width="{Binding IconSize}" Height="{Binding IconSize}" ShowPlaceholder="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border IsVisible="{Binding HasBuilds}" CornerRadius="4" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.GoldDark}" BorderThickness="1" Padding="3,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-12,0" ToolTip.Tip="Used in your builds">
                                          <StackPanel Orientation="Horizontal" Spacing="2">
                                            <c:LucideIcon Kind="book-marked" Width="9" Height="9" Foreground="{DynamicResource Brush.Gold}" />
                                            <TextBlock Text="{Binding BuildCount}" FontSize="9.5" Foreground="{DynamicResource Brush.Gold}" />
                                          </StackPanel>
                                        </Border>
                                      </Panel>
                                      <TextBlock Text="{Binding Name}" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Height="27" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" Spacing="10">
            <TextBlock Text="No runes match these filters." Classes="secondary" HorizontalAlignment="Center" />
            <Button Classes="small" Content="Clear filters" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
      </ScrollViewer>

      <Border Grid.Column="2" Classes="card" Padding="16,14" VerticalAlignment="Stretch">
        <Panel>
          <StackPanel IsVisible="{Binding !HasSelection}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <c:LucideIcon Kind="sparkles" Width="28" Height="28" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
            <TextBlock Text="Pick a rune to see its description, its formulas from the game files and your builds that use it." Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
          </StackPanel>
          <ScrollViewer IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="14" Margin="0,0,6,0" DataContext="{Binding Selected}" x:DataType="vm:RuneTileViewModel" Name="RuneDetails">
              <Grid ColumnDefinitions="Auto,*">
                <c:AssetImage Source="{Binding IconUrl}" Width="56" Height="56" ShowPlaceholder="False" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.GoldLight}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding KindText}" Classes="overline muted" FontSize="10" />
                </StackPanel>
              </Grid>
              <TextBlock c:RiotText.Markup="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="17" />
              <StackPanel Spacing="6" DataContext="{Binding $parent[UserControl].DataContext}" x:DataType="vm:RunesViewModel" IsVisible="{Binding FormulaNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Border Classes="goldline" />
                <TextBlock Text="FORMULAS" Classes="overline" FontSize="10" />
                <ItemsControl ItemsSource="{Binding Formulas}" IsVisible="{Binding HasFormulas}" Name="RuneFormulas">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RuneFormulaRow">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Label}" Classes="secondary" FontSize="12" />
                        <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding FormulaNote}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="6" DataContext="{Binding $parent[UserControl].DataContext}" x:DataType="vm:RunesViewModel">
                <Border Classes="goldline" />
                <TextBlock Text="{Binding UsageTitle}" Classes="overline" FontSize="10" />
                <TextBlock Text="None of your builds use this." Classes="caption" IsVisible="{Binding !HasUsage}" />
                <ItemsControl ItemsSource="{Binding UsageRows}" Name="RuneUsage">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RuneUsage">
                      <Button Classes="listrow" ToolTip.Tip="Open this build"
                              Command="{Binding $parent[UserControl].((vm:RunesViewModel)DataContext).OpenUsageCommand}" CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <c:AssetImage Source="{Binding IconUrl}" Width="26" Height="26" CornerRadius="5" Zoom="1.08" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding Where}" Classes="caption" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
