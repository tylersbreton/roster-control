<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RosterControl.Desktop.ViewModels"
             xmlns:c="using:RosterControl.Desktop.Controls"
             xmlns:v="using:RosterControl.Desktop.Views"
             xmlns:m="using:RosterControl.Core.Model"
             x:Class="RosterControl.Desktop.Views.RostersView"
             x:DataType="vm:RostersViewModel">
  <Grid ColumnDefinitions="314,14,*">

    <!-- ── Champion pool (also a drop zone: drop a roster card here to remove it) ───────────── -->
    <Border Grid.Column="0" Classes="card dropzone" c:Dnd.Target="{Binding}" Padding="0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,16,10">
          <StackPanel Spacing="2">
            <TextBlock Text="CHAMPION POOL" Classes="overline" />
            <TextBlock Text="Drag champions into your groups" Classes="caption" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
          <Button Classes="ghost small" Padding="6,2" VerticalAlignment="Center" ToolTip.Tip="Sort champions">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <c:LucideIcon Kind="arrow-up-down" Width="12" Height="12" />
              <TextBlock Text="{Binding Pool.SortLabel}" FontSize="11" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="A–Z" Command="{Binding Pool.SetSortCommand}" CommandParameter="A–Z" />
                <MenuItem Header="Newest first" Command="{Binding Pool.SetSortCommand}" CommandParameter="Newest" />
                <MenuItem Header="By class" Command="{Binding Pool.SetSortCommand}" CommandParameter="Class" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Border Classes="pill" VerticalAlignment="Center">
            <TextBlock Text="{Binding Pool.CountText}" FontSize="11" Classes="secondary num" />
          </Border>
          </StackPanel>
        </Grid>
        <TextBox Grid.Row="1" Classes="search" Margin="14,0,14,10" PlaceholderText="Search champions…" ToolTip.Tip="Enter opens the first match" Text="{Binding Pool.Search}" c:InputHelpers.EnterCommand="{Binding OpenFirstCommand}" />
        <StackPanel Grid.Row="2" Margin="14,0,14,8" Spacing="8">
          <v:RoleFilterBar DataContext="{Binding Pool}" />
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding Pool.ClassOptions}" SelectedItem="{Binding Pool.SelectedClass}" HorizontalAlignment="Stretch" />
            <CheckBox Grid.Column="1" Content="Hide rostered" IsChecked="{Binding HideAssigned}" Margin="10,0,0,0" ToolTip.Tip="Hide champions that are already in a group" />
          </Grid>
        </StackPanel>
        <ScrollViewer Grid.Row="3">
          <ItemsControl Margin="8,0,6,8" ItemsSource="{Binding Pool.Tiles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChampionTileViewModel">
                <Border Classes="tile" Width="70" Padding="4,6" Margin="1" ToolTip.Tip="{Binding Tooltip}"
                        c:Dnd.Payload="{Binding DragData}"
                        c:Dnd.ClickCommand="{Binding $parent[UserControl].((vm:RostersViewModel)DataContext).OpenChampionCommand}">
                  <Border.ContextMenu>
                    <ContextMenu Opening="OnPoolTileMenuOpening" />
                  </Border.ContextMenu>
                  <StackPanel Spacing="4">
                    <Panel Width="52" Height="52">
                      <c:AssetImage Source="{Binding IconUrl}" Width="52" Height="52" CornerRadius="6" Zoom="1.08" FallbackText="{Binding Name}"
                                    Ring="{DynamicResource Brush.GoldDark}" RingThickness="1" />
                                    <Border IsVisible="{Binding IsNew}" CornerRadius="3" Background="{DynamicResource Brush.Gold}" Padding="4,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-4,0,0" ToolTip.Tip="New this patch"><TextBlock Text="NEW" FontSize="8.5" FontWeight="Bold" LetterSpacing="0.6" Foreground="#060A11" /></Border>
                      <Border IsVisible="{Binding IsInRoster}" Width="17" Height="17" CornerRadius="9" Background="{DynamicResource Brush.Teal}" BorderBrush="{DynamicResource Brush.AppBackground}" BorderThickness="2"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" ToolTip.Tip="In your roster">
                        <c:LucideIcon Kind="check" Width="10" Height="10" Foreground="#04121A" StrokeWidth="3.4" />
                      </Border>
                    </Panel>
                    <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Classes="secondary" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,30,16,0" IsVisible="{Binding Pool.IsEmpty}">
          <TextBlock Text="No champions match these filters." Classes="secondary" HorizontalAlignment="Center" />
          <Button Classes="small" HorizontalAlignment="Center" Command="{Binding Pool.ClearFiltersCommand}">
            <TextBlock Text="Clear filters" FontSize="12" />
          </Button>
        </StackPanel>
        <Border Grid.Row="4" Classes="divider" VerticalAlignment="Top" />
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Margin="16,10,16,12">
          <c:LucideIcon Kind="hand-metal" Width="14" Height="14" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Top" Margin="0,1,7,0" />
          <TextBlock Grid.Column="1" Text="Click to open · right-click to add · drag a card back here to remove it" Classes="caption" TextWrapping="Wrap" />
        </Grid>
      </Grid>
    </Border>

    <!-- ── Roster groups ─────────────────────────────────────────────────────────────────── -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
      <Grid Name="HeaderGrid" ColumnDefinitions="Auto,*,Auto" Margin="2,2,0,12">
        <StackPanel Name="HeaderTitle" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
          <Button Name="RosterSwitcher" Classes="plain" ToolTip.Tip="Switch, create, rename or delete rosters (e.g. Solo/Duo, Flex, ARAM)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding RosterHeading}" Classes="heading" />
              <c:LucideIcon Kind="chevron-down" Width="15" Height="15" Foreground="{DynamicResource Brush.Gold}" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Width="310" Spacing="8">
                  <TextBlock Text="ROSTERS" Classes="overline" />
                  <ItemsControl ItemsSource="{Binding Rosters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RosterChoice">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6"
                                Command="{Binding $parent[UserControl].((vm:RostersViewModel)DataContext).SwitchRosterCommand}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="18,*,Auto">
                            <c:LucideIcon Kind="check" Width="14" Height="14" Foreground="{DynamicResource Brush.Gold}" IsVisible="{Binding IsActive}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="caption" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="divider" />
                  <TextBlock Text="NEW ROSTER" Classes="overline muted" />
                  <TextBox Text="{Binding NewRosterName}" PlaceholderText="Name, e.g. Flex, Clash or ARAM" />
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Classes="small" Command="{Binding NewRosterCommand}" CommandParameter="Roles" Content="One group per role" />
                    <Button Classes="small" Command="{Binding NewRosterCommand}" CommandParameter="Empty" Content="Empty" />
                    <Button Classes="small" Command="{Binding NewRosterCommand}" CommandParameter="Copy" Content="Copy of this roster" />
                  </WrapPanel>
                  <Button Classes="ghost small" HorizontalAlignment="Left" Command="{Binding ImportRosterCommand}" ToolTip.Tip="Add a roster someone shared with you (.rcroster file)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:LucideIcon Kind="upload" Width="13" Height="13" />
                      <TextBlock Text="Import roster from file…" FontSize="12" />
                    </StackPanel>
                  </Button>
                  <Border Classes="divider" />
                  <TextBlock Text="THIS ROSTER" Classes="overline muted" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding RenameText}" c:InputHelpers.EnterCommand="{Binding RenameRosterCommand}" />
                    <Button Grid.Column="1" Classes="small" Margin="6,0,0,0" Command="{Binding RenameRosterCommand}" Content="Rename" />
                  </Grid>
                  <Button Classes="ghost small" HorizontalAlignment="Left" Command="{Binding ShareRosterCommand}" ToolTip.Tip="Save this roster as a file to send to friends or your team">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:LucideIcon Kind="share-2" Width="13" Height="13" />
                      <TextBlock Text="Share as a file…" FontSize="12" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost small" HorizontalAlignment="Left" Command="{Binding DeleteRosterCommand}" IsEnabled="{Binding CanDeleteRoster}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:LucideIcon Kind="trash-2" Width="13" Height="13" Foreground="{DynamicResource Brush.Bad}" />
                      <TextBlock Text="Delete this roster…" FontSize="12" Foreground="{DynamicResource Brush.Bad}" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="Builds, matchups and notes are shared by all rosters." Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBlock Text="{Binding Summary}" Classes="caption" />
        </StackPanel>
        <!-- Priority legend + hint: hidden when the header is too narrow (small window or zoomed in) -->
        <StackPanel Name="HeaderExtras" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
          <ItemsControl ItemsSource="{x:Static vm:PriorityLegend.Items}" VerticalAlignment="Center" Margin="0,0,10,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PriorityLegend">
                <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding Description}">
                  <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Brush}">
                    <c:LucideIcon Kind="{Binding Icon}" Width="9" Height="9" Foreground="#060A11" StrokeWidth="2.6" />
                  </Border>
                  <TextBlock Text="{Binding Label}" Classes="caption" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Width="1" Height="16" Background="{DynamicResource Brush.Border}" Margin="0,0,8,0" />
          <TextBlock Text="Ctrl+click selects · Ctrl + drop copies" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
        </StackPanel>
        <StackPanel Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="ExportImageButton" Classes="ghost icon" Width="32" Height="32" Click="OnExportImageClick" ToolTip.Tip="Save this roster as an image (PNG) to share">
            <c:LucideIcon Kind="image" Width="16" Height="16" />
          </Button>
          <ToggleButton Classes="chip" IsChecked="{Binding Compact}" Height="32" VerticalContentAlignment="Center" ToolTip.Tip="Compact cards: fit more champions per column">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:LucideIcon Kind="list" Width="13" Height="13" Foreground="{Binding $parent[ToggleButton].Foreground}" />
              <TextBlock Text="Compact" FontSize="12" Foreground="{Binding $parent[ToggleButton].Foreground}" />
            </StackPanel>
          </ToggleButton>
          <Button Classes="primary" Command="{Binding AddGroupCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <c:LucideIcon Kind="plus" Width="15" Height="15" Foreground="{DynamicResource Brush.GoldLight}" />
              <TextBlock Text="New group" Foreground="{DynamicResource Brush.GoldLight}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1">
      <!-- Patch review: builds affected by item/rune changes since they were saved -->
      <Border Classes="card" Padding="14,9" Margin="0,0,0,12" IsVisible="{Binding Shell.Review.ShowBanner}" BorderBrush="{DynamicResource Brush.WarningBorder}" Background="{DynamicResource Brush.WarningSoft}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <c:LucideIcon Kind="triangle-alert" Width="16" Height="16" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding Shell.Review.BannerText}" Foreground="{DynamicResource Brush.WarningText}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="2" Classes="small" Margin="10,0,4,0" Command="{Binding Shell.Review.OpenCommand}" Content="Review" />
          <Button Grid.Column="3" Classes="ghost small" Command="{Binding Shell.Review.HideCommand}" Content="Later" ToolTip.Tip="Hide until the next start" />
        </Grid>
      </Border>

      <!-- Multi-selection actions (Ctrl/Shift-click cards) -->
      <Border Grid.Row="1" Classes="card" Padding="12,8" Margin="0,0,0,12" IsVisible="{Binding HasSelection}" BorderBrush="{DynamicResource Brush.GoldDark}">
        <WrapPanel ItemSpacing="8" LineSpacing="6">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="2,0,6,0">
            <c:LucideIcon Kind="check-check" Width="15" Height="15" Foreground="{DynamicResource Brush.Gold}" />
            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.GoldLight}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="small" ToolTip.Tip="Move the selected champions to another group">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:LucideIcon Kind="move" Width="13" Height="13" /><TextBlock Text="Move to" FontSize="12" /><c:LucideIcon Kind="chevron-down" Width="12" Height="12" /></StackPanel>
            <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnMoveSelectionMenuOpening" /></Button.Flyout>
          </Button>
          <Button Classes="small" ToolTip.Tip="Copy the selected champions to another group">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:LucideIcon Kind="copy" Width="13" Height="13" /><TextBlock Text="Copy to" FontSize="12" /><c:LucideIcon Kind="chevron-down" Width="12" Height="12" /></StackPanel>
            <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnCopySelectionMenuOpening" /></Button.Flyout>
          </Button>
          <Button Classes="small" ToolTip.Tip="Set proficiency (or press 0–5)">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:LucideIcon Kind="star" Width="13" Height="13" /><TextBlock Text="Rate" FontSize="12" /><c:LucideIcon Kind="chevron-down" Width="12" Height="12" /></StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="★★★★★  5" Command="{Binding RateSelectionCommand}" CommandParameter="5" />
                <MenuItem Header="★★★★  4" Command="{Binding RateSelectionCommand}" CommandParameter="4" />
                <MenuItem Header="★★★  3" Command="{Binding RateSelectionCommand}" CommandParameter="3" />
                <MenuItem Header="★★  2" Command="{Binding RateSelectionCommand}" CommandParameter="2" />
                <MenuItem Header="★  1" Command="{Binding RateSelectionCommand}" CommandParameter="1" />
                <MenuItem Header="Not rated" Command="{Binding RateSelectionCommand}" CommandParameter="0" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="small" ToolTip.Tip="Set priority">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:LucideIcon Kind="crown" Width="13" Height="13" /><TextBlock Text="Priority" FontSize="12" /><c:LucideIcon Kind="chevron-down" Width="12" Height="12" /></StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Main" Command="{Binding PrioritizeSelectionCommand}" CommandParameter="{x:Static m:ChampionPriority.Main}" />
                <MenuItem Header="Secondary" Command="{Binding PrioritizeSelectionCommand}" CommandParameter="{x:Static m:ChampionPriority.Secondary}" />
                <MenuItem Header="Pocket" Command="{Binding PrioritizeSelectionCommand}" CommandParameter="{x:Static m:ChampionPriority.Pocket}" />
                <MenuItem Header="Learning" Command="{Binding PrioritizeSelectionCommand}" CommandParameter="{x:Static m:ChampionPriority.Learning}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="small" Command="{Binding RemoveSelectionCommand}" ToolTip.Tip="Remove from their groups (Delete)">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:LucideIcon Kind="trash-2" Width="13" Height="13" Foreground="{DynamicResource Brush.Bad}" /><TextBlock Text="Remove" FontSize="12" /></StackPanel>
          </Button>
          <Button Classes="ghost small" Command="{Binding ClearSelectionCommand}" ToolTip.Tip="Clear the selection (Esc)">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:LucideIcon Kind="x" Width="13" Height="13" /><TextBlock Text="Clear" FontSize="12" /></StackPanel>
          </Button>
        </WrapPanel>
      </Border>

      <Border Grid.Row="1" Classes="card" Padding="16,12" Margin="0,0,0,12" IsVisible="{Binding ShowTips}" BorderBrush="{DynamicResource Brush.GoldDark}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <c:LucideIcon Kind="sparkles" Width="20" Height="20" Foreground="{DynamicResource Brush.Gold}" VerticalAlignment="Top" Margin="0,2,14,0" />
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="Getting started" Classes="title" Foreground="{DynamicResource Brush.GoldLight}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="12.5"
                       Text="• Drag champions from the pool into a group — or right-click a champion and choose a group." />
            <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="12.5"
                       Text="• Drag cards between groups to move them (hold Ctrl to copy); drag a card back onto the pool to remove it." />
            <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="12.5"
                       Text="• Click a champion to save rune pages, item sets and matchups. Hover a card and press 1–5 to rate it. Ctrl+K searches everything." />
          </StackPanel>
          <Button Grid.Column="2" Classes="small" VerticalAlignment="Top" Command="{Binding DismissTipsCommand}" Content="Got it" />
        </Grid>
      </Border>
      </StackPanel>

      <ScrollViewer Grid.Row="2" Name="GroupsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RosterGroupViewModel">
              <Border Classes="card dropzone" Width="{Binding $parent[UserControl].((vm:RostersViewModel)DataContext).ColumnWidth}" c:Dnd.Target="{Binding}" c:Dnd.Orientation="Vertical" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*">
                  <!-- Header -->
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,11,8,10">
                    <Panel Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,9,0">
                      <c:AssetImage Source="{Binding RoleIconUrl}" Width="20" Height="20" CornerRadius="0" ShowPlaceholder="False" IsVisible="{Binding HasRoleIcon}" />
                      <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Accent}" IsVisible="{Binding !HasRoleIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <Panel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" LetterSpacing="0.6" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsEditing}"
                                 Foreground="{DynamicResource Brush.GoldLight}" DoubleTapped="OnGroupNameDoubleTapped" ToolTip.Tip="Double-click to rename" />
                      <TextBox Text="{Binding EditName}" IsVisible="{Binding IsEditing}" Padding="6,3" MinHeight="0" FontWeight="SemiBold"
                               KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus" AttachedToVisualTree="OnRenameAttached" />
                    </Panel>
                    <Border Grid.Column="2" Classes="pill" Padding="7,1" Margin="6,0,2,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding CountText}" FontSize="11" Classes="secondary num" />
                    </Border>
                    <Button Grid.Column="3" Classes="ghost icon" Width="26" Height="26" ToolTip.Tip="Group options">
                      <c:LucideIcon Kind="ellipsis" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="Rename" Command="{Binding BeginRenameCommand}"><MenuItem.Icon><c:LucideIcon Kind="pencil" /></MenuItem.Icon></MenuItem>
                          <MenuItem Header="Role">
                            <MenuItem.Icon><c:LucideIcon Kind="target" /></MenuItem.Icon>
                            <MenuItem Header="No role" Command="{Binding SetRoleCommand}" CommandParameter="{x:Null}" />
                            <Separator />
                            <MenuItem Header="Top" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static m:Position.Top}" />
                            <MenuItem Header="Jungle" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static m:Position.Jungle}" />
                            <MenuItem Header="Middle" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static m:Position.Middle}" />
                            <MenuItem Header="Bottom" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static m:Position.Bottom}" />
                            <MenuItem Header="Support" Command="{Binding SetRoleCommand}" CommandParameter="{x:Static m:Position.Support}" />
                          </MenuItem>
                          <MenuItem Header="Colour">
                            <MenuItem.Icon><c:LucideIcon Kind="sparkles" /></MenuItem.Icon>
                            <MenuItem Header="Ember" Command="{Binding SetColorCommand}" CommandParameter="#E0815A"><MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#E0815A" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Jade" Command="{Binding SetColorCommand}" CommandParameter="#6FCB74"><MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#6FCB74" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Sky" Command="{Binding SetColorCommand}" CommandParameter="#6FA8F5"><MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#6FA8F5" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Sun" Command="{Binding SetColorCommand}" CommandParameter="#E5C35C"><MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#E5C35C" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Hextech" Command="{Binding SetColorCommand}" CommandParameter="#5FD3C9"><MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#5FD3C9" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Void" Command="{Binding SetColorCommand}" CommandParameter="#B98CFF"><MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#B98CFF" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Crimson" Command="{Binding SetColorCommand}" CommandParameter="#EE5A6F"><MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#EE5A6F" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Gold" Command="{Binding SetColorCommand}" CommandParameter="#C8AA6E"><MenuItem.Icon><Ellipse Width="12" Height="12" Fill="{DynamicResource Brush.Gold}" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Slate" Command="{Binding SetColorCommand}" CommandParameter="#8C99AD"><MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#8C99AD" /></MenuItem.Icon></MenuItem>
                          </MenuItem>
                          <MenuItem Header="Select all in this group" Command="{Binding $parent[UserControl].((vm:RostersViewModel)DataContext).SelectGroupCommand}" CommandParameter="{Binding}"><MenuItem.Icon><c:LucideIcon Kind="check-check" /></MenuItem.Icon></MenuItem>
                          <Separator />
                          <MenuItem Header="Sort by priority" Command="{Binding SortByPriorityCommand}"><MenuItem.Icon><c:LucideIcon Kind="arrow-down-wide-narrow" /></MenuItem.Icon></MenuItem>
                          <MenuItem Header="Sort by proficiency" Command="{Binding SortByProficiencyCommand}"><MenuItem.Icon><c:LucideIcon Kind="star" /></MenuItem.Icon></MenuItem>
                          <MenuItem Header="Sort by name" Command="{Binding SortByNameCommand}"><MenuItem.Icon><c:LucideIcon Kind="list" /></MenuItem.Icon></MenuItem>
                          <Separator />
                          <MenuItem Header="Move left" Command="{Binding MoveLeftCommand}"><MenuItem.Icon><c:LucideIcon Kind="chevron-left" /></MenuItem.Icon></MenuItem>
                          <MenuItem Header="Move right" Command="{Binding MoveRightCommand}"><MenuItem.Icon><c:LucideIcon Kind="chevron-right" /></MenuItem.Icon></MenuItem>
                          <Separator />
                          <MenuItem Header="Delete group…" Command="{Binding DeleteCommand}"><MenuItem.Icon><c:LucideIcon Kind="trash-2" Foreground="{DynamicResource Brush.Bad}" /></MenuItem.Icon></MenuItem>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <Border Grid.Row="1" Height="2" Background="{Binding Accent}" Opacity="0.85" />

                  <!-- Champions -->
                  <Panel Grid.Row="2">
                    <ScrollViewer>
                      <ItemsControl Margin="7,8,7,8" ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RosterEntryViewModel">
                            <Border Classes="rostercard" Classes.compact="{Binding $parent[UserControl].((vm:RostersViewModel)DataContext).Compact}" Classes.selected="{Binding IsSelected}"
                                    c:Dnd.Payload="{Binding DragData}" c:Dnd.Item="{Binding}" c:Dnd.ClickCommand="{Binding $parent[UserControl].((vm:RostersViewModel)DataContext).CardClickCommand}"
                                    PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited"
                                    ToolTip.Placement="Right" ToolTip.ShowDelay="550" ToolTip.VerticalOffset="0">
                              <ToolTip.Tip>
                                <Panel MinWidth="230" MaxWidth="300">
                                  <TextBlock Text="Loading…" Classes="caption" IsVisible="{Binding IsPreviewLoading}" />
                                  <StackPanel Spacing="8" DataContext="{Binding Preview}" x:DataType="vm:BuildPreview"
                                              IsVisible="{Binding !$parent[Panel].((vm:RosterEntryViewModel)DataContext).IsPreviewLoading}">
                                    <StackPanel Spacing="2">
                                      <TextBlock Text="{Binding ChampionName}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Brush.GoldLight}" />
                                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasBuild}">
                                        <c:LucideIcon Kind="star" Width="12" Height="12" Foreground="{DynamicResource Brush.Gold}" Fill="{DynamicResource Brush.Gold}" IsVisible="{Binding IsDefault}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BuildName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DefaultText}" Classes="caption" VerticalAlignment="Center" />
                                      </StackPanel>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,Auto,*" IsVisible="{Binding HasBuild}">
                                      <c:AssetImage Source="{Binding KeystoneUrl}" Width="34" Height="34" CornerRadius="17" ShowPlaceholder="True" />
                                      <c:AssetImage Grid.Column="1" Source="{Binding SecondaryTreeUrl}" Width="20" Height="20" CornerRadius="10" ShowPlaceholder="False" Margin="4,0,8,0" VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="2" Text="{Binding RuneText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding RuneText}" Classes="secondary" IsVisible="{Binding !HasBuild}" />
                                    <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CompareIcon">
                                          <Border Classes="itemframe"><c:AssetImage Source="{Binding Url}" Width="30" Height="30" CornerRadius="2" FallbackText="?" /></Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding CoreText}" FontSize="11.5" Foreground="{DynamicResource Brush.Gold}" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" IsVisible="{Binding HasCoreText}" />
                                    <ItemsControl ItemsSource="{Binding Spells}" IsVisible="{Binding HasSpells}">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CompareIcon">
                                          <c:AssetImage Source="{Binding Url}" Width="24" Height="24" CornerRadius="4" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Footer}" Classes="caption" />
                                  </StackPanel>
                                </Panel>
                              </ToolTip.Tip>
                              <Border.ContextMenu>
                                <ContextMenu Opening="OnCardMenuOpening">
                                  <MenuItem Header="Open builds" Command="{Binding OpenCommand}"><MenuItem.Icon><c:LucideIcon Kind="book-open" /></MenuItem.Icon></MenuItem>
                                  <MenuItem Header="Open matchups" Command="{Binding OpenMatchupsCommand}"><MenuItem.Icon><c:LucideIcon Kind="swords" /></MenuItem.Icon></MenuItem>
                                  <MenuItem Header="Quick look (always on top)" Command="{Binding QuickLookCommand}"><MenuItem.Icon><c:LucideIcon Kind="eye" /></MenuItem.Icon></MenuItem>
                                  <Separator />
                                  <MenuItem Header="Main" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Main}" />
                                  <MenuItem Header="Secondary" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Secondary}" />
                                  <MenuItem Header="Pocket" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Pocket}" />
                                  <MenuItem Header="Learning" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Learning}" />
                                  <Separator />
                                  <MenuItem Header="Remove from group" Command="{Binding RemoveCommand}"><MenuItem.Icon><c:LucideIcon Kind="x" Foreground="{DynamicResource Brush.Bad}" /></MenuItem.Icon></MenuItem>
                                </ContextMenu>
                              </Border.ContextMenu>
                              <Panel>
                              <!-- Compact layout -->
                              <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding $parent[UserControl].((vm:RostersViewModel)DataContext).Compact}">
                                <c:AssetImage Source="{Binding IconUrl}" Width="26" Height="26" CornerRadius="5" Zoom="1.1" Ring="{Binding PriorityBrush}" RingThickness="1.5" FallbackText="{Binding Name}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,6,0" />
                                <c:StarRating Grid.Column="2" Value="{Binding Proficiency}" StarSize="8.5" VerticalAlignment="Center" />
                              </Grid>
                              <!-- Regular layout -->
                              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !$parent[UserControl].((vm:RostersViewModel)DataContext).Compact}">
                                <Panel Width="42" Height="42">
                                  <c:AssetImage Source="{Binding IconUrl}" Width="42" Height="42" CornerRadius="6" Zoom="1.1" Ring="{Binding PriorityBrush}" RingThickness="1.5" FallbackText="{Binding Name}" />
                                  <!-- Priority badge (click to change) -->
                                  <Button Classes="plain" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6" ToolTip.Tip="{Binding PriorityTooltip}">
                                    <Border Width="19" Height="19" CornerRadius="10" Background="{Binding PriorityBrush}" BorderBrush="{DynamicResource Brush.SurfaceElevated}" BorderThickness="2">
                                      <c:LucideIcon Kind="{Binding PriorityIcon}" Width="9" Height="9" Foreground="#060A11" StrokeWidth="2.6" />
                                    </Border>
                                    <Button.Flyout>
                                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Main — first pick" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Main}" />
                                        <MenuItem Header="Secondary — reliable alternative" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Secondary}" />
                                        <MenuItem Header="Pocket — situational / counter" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Pocket}" />
                                        <MenuItem Header="Learning — still practising" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Learning}" />
                                      </MenuFlyout>
                                    </Button.Flyout>
                                  </Button>
                                </Panel>
                                <Grid Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                    <c:StarRating Value="{Binding Proficiency}" StarSize="10" VerticalAlignment="Center" />
                                    <Button Classes="plain" VerticalAlignment="Center" ToolTip.Tip="Change priority">
                                      <TextBlock Text="{Binding PriorityLabel}" FontSize="8.5" FontWeight="Bold" LetterSpacing="0.2" Foreground="{Binding PriorityBrush}" Opacity="0.85" />
                                      <Button.Flyout>
                                      <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Main — first pick" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Main}" />
                                        <MenuItem Header="Secondary — reliable alternative" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Secondary}" />
                                        <MenuItem Header="Pocket — situational / counter" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Pocket}" />
                                        <MenuItem Header="Learning — still practising" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Learning}" />
                                      </MenuFlyout>
                                      </Button.Flyout>
                                    </Button>
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasBuilds}" ToolTip.Tip="Saved builds">
                                      <c:LucideIcon Kind="book-marked" Width="11" Height="11" Foreground="{DynamicResource Brush.Gold}" />
                                      <TextBlock Text="{Binding BuildCount}" FontSize="10.5" Classes="secondary num" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasMatchups}" ToolTip.Tip="Recorded matchups">
                                      <c:LucideIcon Kind="swords" Width="11" Height="11" Foreground="{DynamicResource Brush.Teal}" />
                                      <TextBlock Text="{Binding MatchupCount}" FontSize="10.5" Classes="secondary num" />
                                    </StackPanel>
                                  </StackPanel>
                                </Grid>
                              </Grid>
                              </Panel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Top" Margin="14,24,14,0" Spacing="10" IsHitTestVisible="False">
                      <Border Height="64" CornerRadius="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{DynamicResource Brush.SurfaceDeep}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                          <c:LucideIcon Kind="plus" Width="18" Height="18" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                          <TextBlock Text="Drop champions here" Classes="caption" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Panel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Share a roster as a file / add a shared roster -->
    <Panel Grid.ColumnSpan="3" IsVisible="{Binding ShareDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Background="{DynamicResource Brush.Overlay}" CornerRadius="10" />
      <Border Classes="card" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,20" BorderBrush="{DynamicResource Brush.GoldDark}" BoxShadow="{DynamicResource Shadow.Popup}"
              DataContext="{Binding ShareDialog}" x:DataType="vm:RosterShareViewModel" Name="RosterShareDialog">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <c:LucideIcon Kind="share-2" Width="18" Height="18" Foreground="{DynamicResource Brush.Gold}" VerticalAlignment="Center" IsVisible="{Binding IsExport}" />
            <c:LucideIcon Kind="upload" Width="18" Height="18" Foreground="{DynamicResource Brush.Gold}" VerticalAlignment="Center" IsVisible="{Binding IsImport}" />
            <TextBlock Text="{Binding Title}" Classes="heading" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Summary}" Classes="secondary" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasWarning}">
            <c:LucideIcon Kind="triangle-alert" Width="14" Height="14" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,1,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding Warning}" Classes="caption" TextWrapping="Wrap" />
          </Grid>

          <!-- Export: what to include -->
          <StackPanel Spacing="8" IsVisible="{Binding IsExport}">
            <TextBlock Text="INCLUDE" Classes="overline muted" />
            <CheckBox IsChecked="{Binding IncludeRatings}" Content="Proficiency and priority of each placement" />
            <CheckBox IsChecked="{Binding IncludeBuilds}" Content="{Binding BuildsOptionText}" IsEnabled="{Binding CanIncludeBuilds}" />
          </StackPanel>

          <!-- Import: new roster or merge -->
          <StackPanel Spacing="8" IsVisible="{Binding IsImport}">
            <RadioButton GroupName="rosterImport" IsChecked="{Binding AsNewRoster, Mode=OneWay}" Command="{Binding ChooseModeCommand}" CommandParameter="new" Content="Add as a new roster" />
            <TextBox Text="{Binding NewName}" Margin="28,0,0,0" IsEnabled="{Binding AsNewRoster}" PlaceholderText="Roster name" />
            <RadioButton GroupName="rosterImport" IsChecked="{Binding Merge, Mode=OneWay}" Command="{Binding ChooseModeCommand}" CommandParameter="merge">
              <TextBlock Text="{Binding MergeText}" TextWrapping="Wrap" />
            </RadioButton>
            <CheckBox IsChecked="{Binding IncludeBuilds}" IsVisible="{Binding HasBuildsToImport}" Margin="0,6,0,0">
              <TextBlock Text="{Binding ImportBuildsText}" TextWrapping="Wrap" />
            </CheckBox>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Classes="primary" Command="{Binding SaveCommand}" IsVisible="{Binding IsExport}" IsDefault="{Binding IsExport}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:LucideIcon Kind="save" Width="13" Height="13" />
                <TextBlock Text="Save file…" />
              </StackPanel>
            </Button>
            <Button Classes="primary" Command="{Binding ImportCommand}" IsVisible="{Binding IsImport}" IsDefault="{Binding IsImport}" Content="Add roster" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- Off-screen host: the roster image is laid out here (clipped away) so portraits load before capture -->
    <Canvas Name="ExportHost" Grid.ColumnSpan="3" Width="0" Height="0" ClipToBounds="True" IsHitTestVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Top" />
  </Grid>
</UserControl>
