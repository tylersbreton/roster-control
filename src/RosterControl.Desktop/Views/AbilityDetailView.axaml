<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RosterControl.Desktop.ViewModels"
             xmlns:gd="using:RosterControl.Core.GameData"
             xmlns:c="using:RosterControl.Desktop.Controls"
             x:Class="RosterControl.Desktop.Views.AbilityDetailView"
             x:DataType="vm:AbilityDetailViewModel">
  <!-- Name, cooldown / cost / range, numbers per rank, then the description -->
  <StackPanel Spacing="7">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Border CornerRadius="3" Background="{DynamicResource Brush.Scrim}" BorderBrush="{Binding Accent}" BorderThickness="1" Padding="5,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding KeyLabel}" FontSize="10" FontWeight="Bold" Foreground="{Binding Accent}" />
      </Border>
      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.GoldLight}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding RankText}" IsVisible="{Binding HasRankText}" FontSize="11.5" VerticalAlignment="Center" Margin="4,0,0,0"
                 Classes.secondary="{Binding !IsNotLearned}" Classes.muted="{Binding IsNotLearned}" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Stats}" IsVisible="{Binding HasStats}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AbilityStat">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding Label}" FontSize="11.5" Classes="secondary" />
            <TextBlock Text="{Binding Value}" FontSize="11.5" Classes="num" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasValues}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AbilityValueRow">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <TextBlock Text="{Binding Label}" Classes="secondary" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Result}" IsVisible="{Binding HasResult}" Foreground="{DynamicResource Brush.Teal}" FontWeight="Bold" FontSize="13" Margin="0,-1,8,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top"
                       Classes.gold="{Binding !HasResult}" Classes.muted="{Binding HasResult}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock c:RiotText.Markup="{Binding Description}" TextWrapping="Wrap" Classes="secondary" FontSize="12" />
  </StackPanel>
</UserControl>
