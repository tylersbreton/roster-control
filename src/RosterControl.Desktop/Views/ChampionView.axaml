<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RosterControl.Desktop.ViewModels"
             xmlns:core="using:RosterControl.Core.Rules"
             xmlns:c="using:RosterControl.Desktop.Controls"
             xmlns:v="using:RosterControl.Desktop.Views"
             xmlns:m="using:RosterControl.Core.Model"
             x:Class="RosterControl.Desktop.Views.ChampionView"
             x:DataType="vm:ChampionDetailViewModel">
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- ── Hero header: splash art, name, placements ────────────────────────────────────── -->
    <Border Grid.Row="0" Height="214" CornerRadius="12" ClipToBounds="True" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1">
      <Panel>
        <c:AssetImage Source="{Binding SplashUrl}" FallbackSource="{Binding SplashFallbackUrl}" DecodeWidth="1600" CornerRadius="12" FocusY="0.28" />
        <Border Background="{DynamicResource Brush.HeroSideFade}" CornerRadius="12" />
        <Border Background="{DynamicResource Brush.HeroFade}" CornerRadius="12" />
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0" CornerRadius="8" Background="{DynamicResource Brush.Glass}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4,3" IsVisible="{Binding HasSequence}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="ghost icon" Width="26" Height="26" Command="{Binding PreviousCommand}" ToolTip.Tip="{Binding PreviousName, StringFormat='Previous: {0} (Ctrl+←)'}">
              <c:LucideIcon Kind="chevron-left" Width="15" Height="15" />
            </Button>
            <TextBlock Text="{Binding SequenceText}" Classes="secondary num" FontSize="12" VerticalAlignment="Center" Margin="4,0" />
            <Button Classes="ghost icon" Width="26" Height="26" Command="{Binding NextCommand}" ToolTip.Tip="{Binding NextName, StringFormat='Next: {0} (Ctrl+→)'}">
              <c:LucideIcon Kind="chevron-right" Width="15" Height="15" />
            </Button>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="26,0,22,20" VerticalAlignment="Bottom">
          <Border Width="92" Height="92" CornerRadius="10" BorderBrush="{DynamicResource Brush.GoldFrame}" BorderThickness="2" Padding="2" Background="{DynamicResource Brush.SurfaceDeep}" BoxShadow="{DynamicResource Shadow.GoldGlow}">
            <c:AssetImage Source="{Binding PortraitUrl}" CornerRadius="7" Zoom="1.08" />
          </Border>
          <StackPanel Grid.Column="1" Margin="20,0,0,2" VerticalAlignment="Bottom" Spacing="6">
            <TextBlock Text="{Binding Name}" Classes="display" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding ChampionTitle}" Classes="secondary" FontStyle="Italic" FontSize="14" VerticalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border CornerRadius="4" Background="{DynamicResource Brush.Glass}" BorderBrush="{DynamicResource Brush.GoldDark}" BorderThickness="1" Padding="7,2">
                      <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Brush.Gold}" FontWeight="SemiBold" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Positions}" VerticalAlignment="Center" IsVisible="{Binding HasPositions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RoleChoice">
                    <c:AssetImage Source="{Binding IconUrl}" Width="17" Height="17" CornerRadius="0" ShowPlaceholder="False" ToolTip.Tip="{Binding Label}" Opacity="0.85" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <!-- Roster placements (proficiency & priority per group) -->
          <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="6" HorizontalAlignment="Right">
            <TextBlock Text="IN YOUR ROSTER" Classes="overline" HorizontalAlignment="Right" IsVisible="{Binding HasPlacements}" />
            <ItemsControl ItemsSource="{Binding Placements}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlacementViewModel">
                  <Border Background="{DynamicResource Brush.Glass}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="10,6,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Border Width="3" Height="18" CornerRadius="2" Background="{Binding Accent}" VerticalAlignment="Center" />
                      <c:AssetImage Source="{Binding RoleIconUrl}" Width="16" Height="16" CornerRadius="0" ShowPlaceholder="False" IsVisible="{Binding HasRoleIcon}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" MinWidth="64" VerticalAlignment="Center" />
                      <c:StarRating Value="{Binding Proficiency}" StarSize="13" VerticalAlignment="Center" />
                      <Button Classes="plain" VerticalAlignment="Center" ToolTip.Tip="Priority">
                        <Border CornerRadius="4" Background="{Binding PrioritySoftBrush}" Padding="7,3" MinWidth="78">
                          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PriorityLabel}" FontSize="10" FontWeight="Bold" LetterSpacing="0.8" Foreground="{Binding PriorityBrush}" />
                            <c:LucideIcon Kind="chevron-down" Width="11" Height="11" Foreground="{Binding PriorityBrush}" />
                          </StackPanel>
                        </Border>
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="Main — first pick" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Main}" />
                            <MenuItem Header="Secondary — reliable alternative" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Secondary}" />
                            <MenuItem Header="Pocket — situational / counter" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Pocket}" />
                            <MenuItem Header="Learning — still practising" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:ChampionPriority.Learning}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button Classes="ghost icon" Width="24" Height="24" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove from this group">
                        <c:LucideIcon Kind="x" Width="13" Height="13" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="small" HorizontalAlignment="Right" IsVisible="{Binding CanAddToGroup}" Background="{DynamicResource Brush.Glass}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:LucideIcon Kind="plus" Width="13" Height="13" />
                <TextBlock Text="Add to group" FontSize="12" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <ItemsControl ItemsSource="{Binding AvailableGroups}" MinWidth="180">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GroupChoice">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7"
                                Command="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).AddToGroupCommand}" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="9">
                            <Ellipse Width="9" Height="9" Fill="{Binding Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Panel>
    </Border>

    <!-- ── Tabs ─────────────────────────────────────────────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="6,10,0,8">
    <StackPanel Orientation="Horizontal" Spacing="26">
      <RadioButton Classes="tab" GroupName="championTabs" IsChecked="{Binding IsBuildsTab}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <c:LucideIcon Kind="book-marked" Width="14" Height="14" Foreground="{Binding $parent[RadioButton].Foreground}" />
          <TextBlock Text="{Binding BuildsTabText}" LetterSpacing="1.2" FontWeight="Bold" FontSize="12" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </StackPanel>
      </RadioButton>
      <RadioButton Classes="tab" GroupName="championTabs" IsChecked="{Binding IsMatchupsTab}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <c:LucideIcon Kind="swords" Width="14" Height="14" Foreground="{Binding $parent[RadioButton].Foreground}" />
          <TextBlock Text="MATCHUPS" LetterSpacing="1.2" FontWeight="Bold" FontSize="12" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </StackPanel>
      </RadioButton>
      <RadioButton Classes="tab" GroupName="championTabs" IsChecked="{Binding IsNotesTab}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <c:LucideIcon Kind="notebook-pen" Width="14" Height="14" Foreground="{Binding $parent[RadioButton].Foreground}" />
          <TextBlock Text="NOTES &amp; TAGS" LetterSpacing="1.2" FontWeight="Bold" FontSize="12" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </StackPanel>
      </RadioButton>
      <RadioButton Classes="tab" GroupName="championTabs" IsChecked="{Binding IsAbilitiesTab}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <c:LucideIcon Kind="zap" Width="14" Height="14" Foreground="{Binding $parent[RadioButton].Foreground}" />
          <TextBlock Text="ABILITIES" LetterSpacing="1.2" FontWeight="Bold" FontSize="12" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </StackPanel>
      </RadioButton>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <Button Classes="small" Command="{Binding QuickLookCommand}" ToolTip.Tip="Show this build in a small always-on-top window (e.g. next to champ select)">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:LucideIcon Kind="eye" Width="13" Height="13" />
          <TextBlock Text="Quick look" FontSize="12" />
        </StackPanel>
      </Button>
      <Button Classes="small" Command="{Binding CompareCommand}" ToolTip.Tip="Compare this champion with another, side by side">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:LucideIcon Kind="columns-2" Width="13" Height="13" />
          <TextBlock Text="Compare" FontSize="12" />
        </StackPanel>
      </Button>
    </StackPanel>
    </Grid>

    <!-- ── Builds ───────────────────────────────────────────────────────────────────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="264,12,*" IsVisible="{Binding IsBuildsTab}">
      <Border Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="14,12,10,8">
            <TextBlock Text="SAVED BUILDS" Classes="overline" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
              <Button Classes="ghost icon" Width="28" Height="28" Command="{Binding PasteShareCodeCommand}" ToolTip.Tip="Paste build code: add a build someone shared with you (copy their RC1: code first)">
                <c:LucideIcon Kind="clipboard-paste" Width="14" Height="14" />
              </Button>
              <Button Classes="ghost small" Command="{Binding AddBuildCommand}" ToolTip.Tip="New build (Ctrl+N)">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:LucideIcon Kind="plus" Width="14" Height="14" Foreground="{DynamicResource Brush.Gold}" />
                  <TextBlock Text="New" FontSize="12" Foreground="{DynamicResource Brush.Gold}" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" c:Dnd.Target="{Binding BuildDrop}">
            <ItemsControl Margin="8,0,8,8" ItemsSource="{Binding Builds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BuildViewModel">
                  <Border Classes="tile" Classes.selectedbuild="{Binding IsSelected}" Padding="10,9" Margin="0,0,0,4" BorderThickness="1" BorderBrush="Transparent"
                          c:Dnd.Payload="{Binding DragData}" c:Dnd.Item="{Binding}"
                          c:Dnd.ClickCommand="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).SelectBuildCommand}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{Binding DefaultMenuText}" Command="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).ToggleDefaultCommand}" CommandParameter="{Binding}"><MenuItem.Icon><c:LucideIcon Kind="star" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Copy share code" Command="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).CopyShareCodeCommand}" CommandParameter="{Binding}"><MenuItem.Icon><c:LucideIcon Kind="share-2" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Copy as League item set" Command="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).CopyItemSetCommand}" CommandParameter="{Binding}"><MenuItem.Icon><c:LucideIcon Kind="shopping-bag" /></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Duplicate" Command="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).DuplicateBuildCommand}" CommandParameter="{Binding}"><MenuItem.Icon><c:LucideIcon Kind="copy" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Move up" Command="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).MoveBuildUpCommand}" CommandParameter="{Binding}"><MenuItem.Icon><c:LucideIcon Kind="chevron-up" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Move down" Command="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).MoveBuildDownCommand}" CommandParameter="{Binding}"><MenuItem.Icon><c:LucideIcon Kind="chevron-down" /></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Delete build…" Command="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).DeleteBuildCommand}" CommandParameter="{Binding}"><MenuItem.Icon><c:LucideIcon Kind="trash-2" Foreground="{DynamicResource Brush.Bad}" /></MenuItem.Icon></MenuItem>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Width="30" Height="30" Margin="0,0,9,0">
                          <c:AssetImage Source="{Binding KeystoneIconUrl}" Width="30" Height="30" CornerRadius="15" ShowPlaceholder="True" />
                          <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource Brush.AppBackground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-3" IsVisible="{Binding SubTreeIconUrl, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <c:AssetImage Source="{Binding SubTreeIconUrl}" Width="12" Height="12" CornerRadius="6" ShowPlaceholder="False" />
                          </Border>
                        </Panel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding RuneSummary}" Classes="caption" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                          <Button Classes="plain" Command="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).ToggleDefaultCommand}" CommandParameter="{Binding}"
                                  ToolTip.Tip="{Binding DefaultTip}" IsVisible="{Binding IsDefault}">
                            <c:LucideIcon Kind="star" Width="14" Height="14" Foreground="{DynamicResource Brush.Gold}" Fill="{DynamicResource Brush.Gold}" />
                          </Button>
                          <c:AssetImage Source="{Binding RoleIconUrl}" Width="16" Height="16" CornerRadius="0" ShowPlaceholder="False" IsVisible="{Binding HasRole}" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <ItemsControl ItemsSource="{Binding SummarySpells}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String"><c:AssetImage Source="{Binding}" Width="20" Height="20" CornerRadius="3" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Width="6" />
                        <ItemsControl ItemsSource="{Binding SummaryItems}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String"><c:AssetImage Source="{Binding}" Width="20" Height="20" CornerRadius="3" Ring="{DynamicResource Brush.GoldDeep}" RingThickness="1" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsFromOlderPatch}" ToolTip.Tip="Items and runes may have changed since. Open the Items tab to see what changed; saving any edit marks the build as up to date.">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SavedOnPatchText}" Classes="caption" Foreground="{DynamicResource Brush.Warning}" />
                      </StackPanel>
                      <TextBlock Text="{Binding SkillSummary}" Classes="caption num" IsVisible="{Binding SkillSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Editor or empty state -->
      <v:BuildEditorView Grid.Column="2" DataContext="{Binding SelectedBuild}" IsVisible="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).HasSelectedBuild}" />
      <Border Grid.Column="2" Classes="card" IsVisible="{Binding !HasBuilds}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="380">
          <c:LucideIcon Kind="book-marked" Width="38" Height="38" Foreground="{DynamicResource Brush.GoldDark}" HorizontalAlignment="Center" />
          <TextBlock Text="NO BUILDS YET" Classes="heading" HorizontalAlignment="Center" />
          <TextBlock Text="Save rune pages, item sets, summoner spells and a skill order — make one per role or matchup (e.g. Standard, vs AP, Aggressive)." Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
          <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding AddBuildCommand}" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <c:LucideIcon Kind="plus" Width="15" Height="15" Foreground="{DynamicResource Brush.GoldLight}" />
              <TextBlock Text="Create first build" Foreground="{DynamicResource Brush.GoldLight}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ── Matchups ─────────────────────────────────────────────────────────────────────── -->
    <v:MatchupsView Grid.Row="2" DataContext="{Binding Matchups}" IsVisible="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).IsMatchupsTab}" />

    <!-- ── Abilities ────────────────────────────────────────────────────────────────────── -->
    <ScrollViewer Grid.Row="2" IsVisible="{Binding IsAbilitiesTab}">
      <StackPanel DataContext="{Binding Abilities}" x:DataType="vm:AbilitiesViewModel" Spacing="10" MaxWidth="1100" HorizontalAlignment="Left" Margin="0,0,8,8">
        <TextBlock Text="Loading abilities…" Classes="secondary" IsVisible="{Binding IsLoading}" Margin="4,4" />
        <!-- Calculator: stats and numbers at a level with the items you tick -->
        <Panel IsVisible="{Binding HasCalculator}">
          <Border Classes="card" Padding="16,14" DataContext="{Binding Calculator}" x:DataType="vm:AbilityCalculatorViewModel" Name="AbilityCalculator">
            <Grid ColumnDefinitions="*,24,360" RowDefinitions="Auto,Auto">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="CALCULATOR" Classes="overline" />
                  <TextBlock Text="Your stats and every ability's numbers at a level, with the items you tick. Ranks follow the build's skill order." Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="Build" Classes="secondary" VerticalAlignment="Center" Width="52" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding BuildChoices}" SelectedItem="{Binding SelectedChoice}" MinWidth="240" HorizontalAlignment="Left" Name="CalculatorBuild">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:CalculatorBuildChoice">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                  <TextBlock Text="{Binding LevelText}" Classes="title num" VerticalAlignment="Center" Width="72" />
                  <Button Grid.Column="1" Classes="ghost icon" Command="{Binding LevelDownCommand}" ToolTip.Tip="One level down" VerticalAlignment="Center">
                    <c:LucideIcon Kind="minus" Width="14" Height="14" />
                  </Button>
                  <Slider Grid.Column="2" Minimum="1" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="3"
                          Value="{Binding Level}" Margin="8,0" VerticalAlignment="Center" Name="CalculatorLevel" />
                  <Button Grid.Column="3" Classes="ghost icon" Command="{Binding LevelUpCommand}" ToolTip.Tip="One level up" VerticalAlignment="Center">
                    <c:LucideIcon Kind="plus" Width="14" Height="14" />
                  </Button>
                </Grid>
                <TextBlock Text="{Binding RanksText}" Classes="caption" TextWrapping="Wrap" />
                <StackPanel Spacing="6" IsVisible="{Binding HasBuild}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Text="ITEMS" Classes="overline" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ItemsText}" Classes="caption num" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Classes="ghost small" Content="All" Command="{Binding AllItemsCommand}" IsVisible="{Binding HasItems}" />
                    <Button Grid.Column="3" Classes="ghost small" Content="None" Command="{Binding NoItemsCommand}" IsVisible="{Binding HasItems}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CalculatorItem">
                        <StackPanel Spacing="3">
                          <ToggleButton Classes="calcitem" IsChecked="{Binding IsOn}" ToolTip.Tip="{Binding Tip}" Padding="0">
                            <Panel Width="38" Height="38">
                              <c:AssetImage Source="{Binding IconUrl}" CornerRadius="4" />
                              <Border CornerRadius="4" Background="{DynamicResource Brush.Overlay}" IsVisible="{Binding !IsOn}" />
                            </Panel>
                          </ToggleButton>
                          <ToggleButton Classes="chip" IsChecked="{Binding IsSwapSource, Mode=OneWay}" IsEnabled="{Binding IsOn}" Height="20" Padding="0" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" ToolTip.Tip="{Binding Name, StringFormat='Compare {0} with other items'}"
                                        Command="{Binding $parent[ItemsControl].((vm:AbilityCalculatorViewModel)DataContext).SwapCommand}" CommandParameter="{Binding}">
                            <c:LucideIcon Kind="arrow-left-right" Width="11" Height="11" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                          </ToggleButton>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="This build has no items yet." Classes="caption" IsVisible="{Binding !HasItems}" />
                  <CheckBox IsChecked="{Binding IncludeShards}" IsVisible="{Binding HasShards}">
                    <TextBlock Text="{Binding ShardsText}" TextWrapping="Wrap" FontSize="12" />
                  </CheckBox>
                  <TextBlock Text="{Binding ShardsText}" Classes="caption" IsVisible="{Binding !HasShards}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="{Binding LevelText, StringFormat='STATS · {0}'}" Classes="overline" />
                <ItemsControl ItemsSource="{Binding Stats}" Name="CalculatorStats">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalculatorStat">
                      <Grid ColumnDefinitions="130,70,*">
                        <TextBlock Text="{Binding Label}" Classes="secondary" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="num" FontWeight="SemiBold" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="caption" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Footnote}" Classes="caption" TextWrapping="Wrap" Margin="0,12,0,0" />
            </Grid>
          </Border>
        </Panel>
        <!-- Item choices: the best next item for a number, or what swapping a counted item changes -->
        <Panel IsVisible="{Binding HasCalculator}">
          <Border Classes="card" Padding="16,14" DataContext="{Binding Calculator}" x:DataType="vm:AbilityCalculatorViewModel" Name="CalculatorChoices">
            <Grid ColumnDefinitions="*,24,360">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding ChoicesTitle}" Classes="overline" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="1" Classes="ghost small" Command="{Binding EndSwapCommand}" IsVisible="{Binding IsSwapping}" Content="Back to best next item" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="Rank by" Classes="secondary" VerticalAlignment="Center" Width="62" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Metrics}" SelectedItem="{Binding FocusMetric}" MinWidth="260" MaxDropDownHeight="420" HorizontalAlignment="Left" Name="CalculatorFocus"
                            ToolTip.Tip="The number items are ranked by">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="core:CalcMetric">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <TextBlock Text="{Binding ChoicesHint}" Classes="caption" TextWrapping="Wrap" />
                <TextBlock Text="Use the ⇄ button under an item above to compare it with other items." Classes="caption" IsVisible="{Binding !IsSwapping}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding HasChoices}" Name="CalculatorChoiceList">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemChoiceViewModel">
                      <Button Classes="listrow" Classes.selected="{Binding IsSelected}"
                              Command="{Binding $parent[ItemsControl].((vm:AbilityCalculatorViewModel)DataContext).PreviewItemCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Show everything this item changes">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                          <Border Classes="itemframe">
                            <c:AssetImage Source="{Binding IconUrl}" Width="28" Height="28" CornerRadius="2" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ValueText}" Classes="caption" IsVisible="{Binding HasValueText}" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding GainText}" Foreground="{Binding GainBrush}" FontWeight="Bold" FontSize="13" Classes="num" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding PercentText}" Classes="caption num" IsVisible="{Binding HasPercent}" VerticalAlignment="Center" Margin="6,0,0,0" Width="40" TextAlignment="Right" />
                          <TextBlock Grid.Column="4" Text="{Binding GoldText}" Foreground="{DynamicResource Brush.Gold}" FontSize="12" Classes="num" VerticalAlignment="Center" Margin="10,0,0,0" Width="72" TextAlignment="Right" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ChoicesEmptyText}" Classes="secondary" FontSize="12.5" IsVisible="{Binding !HasChoices}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="2" Background="{DynamicResource Brush.SurfaceSunken}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,10" VerticalAlignment="Top" Name="CalculatorPreview">
                <Panel>
                  <StackPanel IsVisible="{Binding !HasPreview}" Spacing="6" Margin="0,6">
                    <c:LucideIcon Kind="arrow-left-right" Width="22" Height="22" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Pick an item on the left to see every stat and ability number it changes at this level." Classes="caption" TextWrapping="Wrap" TextAlignment="Center" />
                  </StackPanel>
                  <StackPanel IsVisible="{Binding HasPreview}" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                      <Button Grid.Column="1" Classes="ghost icon" Command="{Binding ClosePreviewCommand}" ToolTip.Tip="Close" VerticalAlignment="Top">
                        <c:LucideIcon Kind="x" Width="13" Height="13" />
                      </Button>
                    </Grid>
                    <TextBlock Text="{Binding PreviewGold}" Foreground="{DynamicResource Brush.Gold}" FontSize="12" Classes="num" />
                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MetricChangeRow">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{Binding Label}" Classes="secondary" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding DeltaText}" Foreground="{Binding Brush}" FontWeight="Bold" FontSize="12" Classes="num" Margin="8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Text}" Classes="caption num" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nothing the calculator counts changes (the item's value is in its passive or active)." Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !HasPreviewRows}" />
                    <TextBlock Text="Listed stats only: passives and actives aren't counted." Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasPreviewRows}" />
                  </StackPanel>
                </Panel>
              </Border>
            </Grid>
          </Border>
        </Panel>
        <!-- Power curve: one number from level 1 to 18 as the build's items are finished -->
        <Panel IsVisible="{Binding HasCalculator}">
          <Border Classes="card" Padding="16,14" DataContext="{Binding Calculator}" x:DataType="vm:AbilityCalculatorViewModel" Name="CalculatorCurve">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="POWER CURVE" Classes="overline" />
                  <TextBlock Text="{Binding CurveSummary}" Classes="caption num" />
                </StackPanel>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Metrics}" SelectedItem="{Binding CurveMetric}" MinWidth="260" MaxDropDownHeight="420" Name="CurveMetricPicker"
                          ToolTip.Tip="The number the curve shows">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:CalcMetric">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <c:LevelChart Series="{Binding CurveSeries}" Markers="{Binding CurveMarkers}" HighlightLevel="{Binding Level}" Height="220" Name="CurveChart" />
              <StackPanel Spacing="6" IsVisible="{Binding HasTimeline}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="FINISHED AT LEVEL" Classes="overline" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Set when you usually finish each item; starter items count from level 1." Classes="caption" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="2" Classes="ghost small" Content="Reset to the default spread" Command="{Binding ResetTimelineCommand}" IsVisible="{Binding TimelineIsCustom}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Timeline}" Name="CurveTimeline">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimelineItemViewModel">
                      <StackPanel Spacing="3" ToolTip.Tip="{Binding Tip}">
                        <Border Classes="itemframe" HorizontalAlignment="Center">
                          <c:AssetImage Source="{Binding IconUrl}" Width="34" Height="34" CornerRadius="2" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <Button Classes="ghost icon" Padding="2" Command="{Binding EarlierCommand}" ToolTip.Tip="One level earlier">
                            <c:LucideIcon Kind="chevron-left" Width="11" Height="11" />
                          </Button>
                          <TextBlock Text="{Binding Level}" Classes="num" FontWeight="SemiBold" FontSize="12" MinWidth="18" TextAlignment="Center" VerticalAlignment="Center" />
                          <Button Classes="ghost icon" Padding="2" Command="{Binding LaterCommand}" ToolTip.Tip="One level later">
                            <c:LucideIcon Kind="chevron-right" Width="11" Height="11" />
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Text="Tick items in the calculator to add them to the curve." Classes="caption" IsVisible="{Binding !HasTimeline}" />
            </StackPanel>
          </Border>
        </Panel>
        <ItemsControl ItemsSource="{Binding Abilities}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AbilityDetailViewModel">
              <Border Classes="card" Padding="16,14">
                <Grid ColumnDefinitions="Auto,*">
                  <c:AssetImage Source="{Binding IconUrl}" Width="52" Height="52" CornerRadius="6" Ring="{Binding Accent}" RingThickness="1" FallbackText="{Binding Key}" VerticalAlignment="Top" />
                  <v:AbilityDetailView Grid.Column="1" Margin="16,0,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- The build's keystone and runes with formulas, at the calculator's level -->
        <Panel IsVisible="{Binding HasCalculator}">
          <Border Classes="card" Padding="16,14" DataContext="{Binding Calculator}" x:DataType="vm:AbilityCalculatorViewModel" IsVisible="{Binding HasRunes}" Name="CalculatorRunes">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding LevelText, StringFormat='RUNES · {0}'}" Classes="overline" />
              <ItemsControl ItemsSource="{Binding Runes}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalculatorRune">
                    <Grid ColumnDefinitions="Auto,*">
                      <c:AssetImage Source="{Binding IconUrl}" Width="38" Height="38" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource Brush.GoldLight}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding KindText}" Classes="overline muted" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AbilityValueRow">
                              <Grid ColumnDefinitions="Auto,Auto,*">
                                <TextBlock Text="{Binding Label}" Classes="secondary" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Result}" IsVisible="{Binding HasResult}" Foreground="{DynamicResource Brush.Teal}" FontWeight="Bold" FontSize="13" Margin="0,-1,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Text}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasNote}">
                          <c:LucideIcon Kind="info" Width="13" Height="13" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,1,6,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="caption" TextWrapping="Wrap" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Panel>
        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="4,0">
          <c:LucideIcon Kind="info" Width="13" Height="13" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Top" Margin="0,1,8,0" />
          <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="caption" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- ── Notes & tags ─────────────────────────────────────────────────────────────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="*,12,340" IsVisible="{Binding IsNotesTab}">
      <Border Classes="card" Padding="16,14">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="CHAMPION NOTES" Classes="overline" />
            <TextBlock Text="Power spikes, combos, wave management, reminders — anything you want to remember. Saved automatically." Classes="caption" />
          </StackPanel>
          <c:NotesEditor Grid.Row="1" Text="{Binding Notes}" PlaceholderText="Write your notes for this champion… (- bullets, [ ] checkboxes, **bold**)" />
        </Grid>
      </Border>
      <Border Grid.Column="2" Classes="card" Padding="16,14" VerticalAlignment="Top">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="TAGS" Classes="overline" />
            <TextBlock Text="Your own labels, e.g. “Blind pick”, “Teamfight”, “One-trick”. Filter by tag on the Champions page." Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding UserTags}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border CornerRadius="999" Background="{DynamicResource Brush.GoldSoft}" BorderBrush="{DynamicResource Brush.GoldDark}" BorderThickness="1" Padding="10,3,4,3" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.GoldLight}" VerticalAlignment="Center" />
                    <Button Classes="ghost icon" Width="18" Height="18" Command="{Binding $parent[UserControl].((vm:ChampionDetailViewModel)DataContext).RemoveTagCommand}" CommandParameter="{Binding}">
                      <c:LucideIcon Kind="x" Width="11" Height="11" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding NewTag}" PlaceholderText="Add a tag…" KeyDown="OnTagKeyDown" />
            <Button Grid.Column="1" Margin="6,0,0,0" Command="{Binding AddTagCommand}" Classes="primary">
              <c:LucideIcon Kind="plus" Width="15" Height="15" Foreground="{DynamicResource Brush.GoldLight}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
