<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RosterControl.Desktop.ViewModels"
             xmlns:c="using:RosterControl.Desktop.Controls"
             xmlns:v="using:RosterControl.Desktop.Views"
             x:Class="RosterControl.Desktop.Views.BuildEditorView"
             x:DataType="vm:BuildViewModel">
  <Border Classes="card" Padding="0">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto" Margin="12,10,12,0">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBox Classes="inline" Text="{Binding Name}" FontSize="17" FontWeight="Bold" MinWidth="160" MaxWidth="360" PlaceholderText="Build name" />
          <ComboBox ItemsSource="{Binding RoleChoices}" SelectedItem="{Binding SelectedRole}" VerticalAlignment="Center" MinWidth="130" ToolTip.Tip="Role this build is for">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RoleChoice">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <c:AssetImage Source="{Binding IconUrl}" Width="15" Height="15" CornerRadius="0" ShowPlaceholder="False" IsVisible="{Binding HasIcon}" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="ghost icon" ToolTip.Tip="Copy share code (paste it in Discord; friends add it with Paste build code)"
                  Command="{Binding $parent[v:ChampionView].((vm:ChampionDetailViewModel)DataContext).CopyShareCodeCommand}" CommandParameter="{Binding}">
            <c:LucideIcon Kind="share-2" />
          </Button>
          <Button Classes="ghost icon" ToolTip.Tip="Copy as League item set: paste it in the client (Collection → Items → import) to see this build in the in-game shop"
                  Command="{Binding $parent[v:ChampionView].((vm:ChampionDetailViewModel)DataContext).CopyItemSetCommand}" CommandParameter="{Binding}">
            <c:LucideIcon Kind="shopping-bag" />
          </Button>
          <Button Classes="ghost icon" ToolTip.Tip="Copy this build to another champion">
            <c:LucideIcon Kind="layers" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="280" Spacing="8" DataContext="{Binding $parent[v:ChampionView].DataContext}" x:DataType="vm:ChampionDetailViewModel">
                  <TextBlock Text="COPY TO ANOTHER CHAMPION" Classes="overline" />
                  <TextBlock Text="Copies runes, items, spells and notes (not the skill order)." Classes="caption" TextWrapping="Wrap" />
                  <TextBox Classes="search" Text="{Binding CopyQuery}" PlaceholderText="Champion name…" />
                  <ItemsControl ItemsSource="{Binding CopyTargets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CopyTarget">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,4"
                                Command="{Binding $parent[ItemsControl].((vm:ChampionDetailViewModel)DataContext).CopyBuildToCommand}" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:AssetImage Source="{Binding IconUrl}" Width="24" Height="24" CornerRadius="4" Zoom="1.1" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="ghost icon" ToolTip.Tip="Duplicate build"
                  Command="{Binding $parent[v:ChampionView].((vm:ChampionDetailViewModel)DataContext).DuplicateBuildCommand}" CommandParameter="{Binding}">
            <c:LucideIcon Kind="copy" />
          </Button>
          <Button Classes="ghost icon" ToolTip.Tip="Delete build"
                  Command="{Binding $parent[v:ChampionView].((vm:ChampionDetailViewModel)DataContext).DeleteBuildCommand}" CommandParameter="{Binding}">
            <c:LucideIcon Kind="trash-2" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Warnings: likely mistakes, each can be ignored for this build -->
      <StackPanel Grid.Row="1" Margin="12,8,12,0" Spacing="4" IsVisible="{Binding ShowWarningStrip}" Name="BuildWarnings">
        <ItemsControl ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BuildWarningViewModel">
              <Border Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.WarningBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:LucideIcon Kind="triangle-alert" Width="14" Height="14" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,2,9,0" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Brush.WarningText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="ghost small" Content="Ignore" VerticalAlignment="Center" Margin="8,0,0,0"
                          ToolTip.Tip="Hide this warning for this build (it's on purpose)"
                          Command="{Binding $parent[v:BuildEditorView].((vm:BuildViewModel)DataContext).IgnoreWarningCommand}" CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding IgnoredWarnings}" IsVisible="{Binding ShowIgnored}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BuildWarningViewModel">
              <Border Background="{DynamicResource Brush.SurfaceSunken}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:LucideIcon Kind="eye-off" Width="14" Height="14" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Top" Margin="0,2,9,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" Classes="secondary" TextWrapping="Wrap" />
                  <Button Grid.Column="2" Classes="ghost small" Content="Show again" VerticalAlignment="Center" Margin="8,0,0,0"
                          Command="{Binding $parent[v:BuildEditorView].((vm:BuildViewModel)DataContext).RestoreWarningCommand}" CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="ghost small" Content="{Binding IgnoredText}" Command="{Binding ToggleIgnoredCommand}" HorizontalAlignment="Right"
                IsVisible="{Binding HasIgnored}" Name="IgnoredWarningsToggle" Margin="0,-2,0,-6" />
      </StackPanel>

      <!-- Editor tabs -->
      <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="16,4,16,0">
        <StackPanel Orientation="Horizontal" Spacing="24">
          <RadioButton Classes="tab" GroupName="editorTabs" IsChecked="{Binding IsRunesTab}">
            <TextBlock Text="RUNES" LetterSpacing="1.2" FontWeight="Bold" FontSize="12" Foreground="{Binding $parent[RadioButton].Foreground}" />
          </RadioButton>
          <RadioButton Classes="tab" GroupName="editorTabs" IsChecked="{Binding IsItemsTab}">
            <TextBlock Text="ITEMS" LetterSpacing="1.2" FontWeight="Bold" FontSize="12" Foreground="{Binding $parent[RadioButton].Foreground}" />
          </RadioButton>
          <RadioButton Classes="tab" GroupName="editorTabs" IsChecked="{Binding IsSpellsTab}">
            <TextBlock Text="SPELLS &amp; SKILLS" LetterSpacing="1.2" FontWeight="Bold" FontSize="12" Foreground="{Binding $parent[RadioButton].Foreground}" />
          </RadioButton>
          <RadioButton Classes="tab" GroupName="editorTabs" IsChecked="{Binding IsNotesTab}">
            <TextBlock Text="NOTES" LetterSpacing="1.2" FontWeight="Bold" FontSize="12" Foreground="{Binding $parent[RadioButton].Foreground}" />
          </RadioButton>
        </StackPanel>
        <Border Grid.Row="1" Classes="divider" />
      </Grid>

      <!-- Editors (created on demand for the selected build) -->
      <Panel Grid.Row="3" Margin="14,12,14,14">
        <v:RunePageView DataContext="{Binding Runes}" IsVisible="{Binding $parent[v:BuildEditorView].((vm:BuildViewModel)DataContext).IsRunesTab}" />
        <v:ItemSetView DataContext="{Binding Items}" IsVisible="{Binding $parent[v:BuildEditorView].((vm:BuildViewModel)DataContext).IsItemsTab}" />
        <v:SpellsSkillsView DataContext="{Binding SpellsSkills}" IsVisible="{Binding $parent[v:BuildEditorView].((vm:BuildViewModel)DataContext).IsSpellsTab}" />
        <c:NotesEditor Text="{Binding Notes}" IsVisible="{Binding IsNotesTab}"
                       PlaceholderText="Notes for this build: when to take it, power spikes, what to build against what… (- bullets, [ ] checkboxes, **bold**)" />
      </Panel>
    </Grid>
  </Border>
</UserControl>
